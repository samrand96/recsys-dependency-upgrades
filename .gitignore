# Results: ledger, run artifacts and per-user metrics stay local
results/

# LaTeX build output
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/main.pdf

